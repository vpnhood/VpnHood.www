---
# Rendered by Jekyll (the front matter makes it a page). The land dots are the
# static list in _includes/globe-land-points.json, generated by
# tools/make-land-dots.py from Natural Earth on a true equirectangular
# 2048x1024 canvas (x = (lng + 180) * 5.6889, y = (90 - lat) * 5.6889, which is
# exactly how globe.js wraps the canvas onto the sphere). The country dots are
# placed from _data/locations.yml with the same formula, so the globe shows the
# same countries as everything else and each one lands on its own coastline.
sitemap: false
---
{"points":{% include globe-land-points.json %},"countries":{ {%- for c in site.data.locations.countries -%}
"{{ c.key }}":{"x":{{ c.lng | plus: 180 | times: 5.6889 | round }},"y":{{ 90 | minus: c.lat | times: 5.6889 | round }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%} }}
